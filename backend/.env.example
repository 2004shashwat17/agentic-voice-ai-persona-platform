# ---------------------------------------------------------------------------
# PersonaAI backend — example environment file
#
# Copy to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit a real .env file or any secret values.
# ---------------------------------------------------------------------------

# --- Application ---------------------------------------------------------
APP_NAME=PersonaAI API
APP_ENV=development
DEBUG=false

# --- API -----------------------------------------------------------------
API_V1_PREFIX=/api/v1

# --- Database ------------------------------------------------------------
# PostgreSQL connection URL. Never commit real credentials.
# Local PostgreSQL 18 (Homebrew) example:
DATABASE_URL=postgresql+psycopg://shashwatsaxena@localhost:5432/personaai
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- CORS ----------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Local:  http://localhost:3000
# Never hardcode production domains in the source tree.
CORS_ORIGINS=http://localhost:3000

# --- Logging -------------------------------------------------------------
# One of: CRITICAL, ERROR, WARNING, INFO, DEBUG, NOTSET
LOG_LEVEL=INFO

# true = JSON logs (recommended in production / log aggregators)
LOG_JSON=false

# --- Testing (optional) --------------------------------------------------
# Overrides the database used by integration tests. Defaults to DATABASE_URL.
# TEST_DATABASE_URL=postgresql+psycopg://shashwatsaxena@localhost:5432/personaai_test


